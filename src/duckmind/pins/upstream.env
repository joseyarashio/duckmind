# What duckmind downloads but does not ship, pinned. Read by `python -m duckmind.setup_cmd`
# (duckmind.pins) and sourced by the public play image (deploy/public/image/Dockerfile).
# KEY=VALUE lines only; the sha256 of every downloaded file is in the *.sha256 files beside this one.

# Pollen's microduck at the daemon-v0.18.5 tag: robotd, tofd, the sounds tool (Apache-2.0)
MICRODUCK_URL=https://github.com/pollen-robotics/microduck.git
MICRODUCK_TAG=daemon-v0.18.5
MICRODUCK_COMMIT=54e0789635ae28120be9ea0dd51750a494ab50ac
# duckmind's robot.poseJoints patch for that robotd (in this repository)
MICRODUCK_PATCH=third_party/microduck_emotions/robotd-poseJoints-0.18.5.patch
# Pollen's microduck_rl at duckmind's pinned commit (duckmind.training.UPSTREAM_COMMIT): the MJCF and
# body server (Apache-2.0) and the 3D meshes (CC BY-NC-SA 4.0)
MICRODUCK_RL_URL=https://github.com/pollen-robotics/microduck_rl.git
MICRODUCK_RL_COMMIT=cb70b792312d559a4da09064d92009079671815f
# Hugging Face pollen-robotics/microduck-policies (Apache-2.0): policy set v9 (the live duck's),
# and v5 (what the tests and the training tools were measured with)
POLICIES_REPO=pollen-robotics/microduck-policies
POLICIES_REV=v9
POLICIES_V5_REV=v5
# Hugging Face joseyarashio/duckmind-motion-skills (Apache-2.0): duckmind's seven trained motions
MOTIONS_REPO=joseyarashio/duckmind-motion-skills
MOTIONS_REV=716a82f06a1f6fb86d256fce3e0a318f97e33004
