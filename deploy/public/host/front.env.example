# duckmind public play front: settings (install.sh copies this to /etc/duckmind-public/front.env once).
# After a change: systemctl reload duckmind-front (the running duck is not touched).

# Kill switch: anything but true shows the guiding page ("today's ducks are all adopted"), starts no
# duck, empties the line and stops a playing duck within CHECK_INTERVAL_S.
OPEN=false

# Turnstile: the public hostname (duck.<your domain>) and the widget's public sitekey.
# The secret goes in /etc/duckmind-public/secrets.env (TURNSTILE_SECRET), never here.
TURNSTILE_HOSTNAMES=
TURNSTILE_SITEKEY=

# The duck image (refresh-image.sh sets this).
DUCK_HOST_IMAGE=

# One duck at a time, a short line (a place lapses when its page stops asking for 60 s).
MAX_LIVE=1
MAX_QUEUE=6
# Minutes of play; the duck keeps its .duck download EXPORT_MINUTES more, then exits by itself.
SESSION_MINUTES=5
EXPORT_MINUTES=3
# A playing page that sends nothing for this long ends early.
IDLE_END_S=120
CHECK_INTERVAL_S=15
# Traffic cap: the host sends at most this many GB (10^9 bytes) to the internet per calendar month (UTC):
# AWS bills past 100 GB a month, shared with the owner's other machines. Each playing duck reserves
# SESSION_EGRESS_MB; when one more would not fit, no new duck starts and the guiding page shows until the
# month ends. The count survives restarts (/var/lib/duckmind-front/egress.json).
MONTHLY_EGRESS_GB=90
SESSION_EGRESS_MB=300

# Per visitor address: ducks at once (playing or in line), starts per window.
MAX_PER_ADDRESS=1
START_RATE_MAX=3
START_WINDOW_S=3600

# Where the front listens (loopback only) and the duck containers.
DUCK_HOST_LISTEN=127.0.0.1:8780
DUCK_HOST_TUNNEL_SOCKET=/run/duckmind-front/tunnel.sock
DUCK_HOST_PORT_BASE=18080
DUCK_HOST_NETWORK=duckmind-public
DUCK_HOST_CPUS=2
DUCK_HOST_MEMORY=3g
DUCK_HOST_FONTS=/opt/duckmind-front/fonts
DUCK_HOST_IMAGES=/opt/duckmind-front/images
